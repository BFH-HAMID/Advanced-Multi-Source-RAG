# =============================================================================
# Advanced Multi-Source RAG — environment configuration
# Copy to .env and fill in what you need:  cp .env.example .env
# Every value below is optional; the defaults shown are what the app uses.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM: anthropic (Claude) | openai | ollama | extractive
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
# Leave empty to use the provider default (gpt-4o-mini / claude-3-5-sonnet-latest / qwen2.5:7b)
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible gateway (vLLM, Azure proxy, OpenRouter, ...)
OPENAI_BASE_URL=

# Claude API
ANTHROPIC_API_KEY=

# Local models via Ollama (ollama serve) — `ollama pull qwen2.5:7b` first
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings: sentence_transformers (bge-m3) | openai | hashing (offline)
# BAAI/bge-m3 is multilingual and handles Bangla + English in one vector space.
# -----------------------------------------------------------------------------
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=auto          # auto | cpu | cuda | mps
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true
EMBEDDING_CACHE=true

# -----------------------------------------------------------------------------
# Reranker: cross_encoder (bge-reranker-v2-m3) | cohere | lexical | none
# -----------------------------------------------------------------------------
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# -----------------------------------------------------------------------------
# Chunking / processing
# -----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
SENTENCE_WINDOW_SIZE=3
MIN_CHUNK_CHARS=40
CSV_ROWS_PER_DOCUMENT=6
MAX_PDF_PAGES=0                # 0 = all pages

# -----------------------------------------------------------------------------
# Retrieval & fusion
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
RETRIEVER_TIMEOUT_SECONDS=60
VECTOR_WEIGHT=1.0
WINDOW_WEIGHT=1.0
GRAPH_WEIGHT=0.9
USE_RRF=true
RRF_K=60
# Relevance gate: answers below this rerank score become "not found in documents".
# 0 = use the reranker default (lexical 0.10, cross-encoder 0.02, cohere 0.05).
MIN_RERANK_SCORE=0
MAX_CONTEXT_TOKENS=3000

# -----------------------------------------------------------------------------
# Knowledge graph
# -----------------------------------------------------------------------------
GRAPH_MAX_HOPS=2
GRAPH_EXTRACTION_BATCH_SIZE=8
GRAPH_MAX_CHUNKS=0             # 0 = all chunks
GRAPH_MIN_ENTITY_LEN=2
GRAPH_MAX_ENTITIES_PER_CHUNK=20

# -----------------------------------------------------------------------------
# Behaviour
# -----------------------------------------------------------------------------
# When a model/API is unavailable, fall back to offline components instead of failing.
ALLOW_MODEL_FALLBACKS=true
LOG_LEVEL=INFO
# DATA_DIR=./data           # override the storage root
